# Server Environment
PORT=3000
NODE_ENV=production

# Security Keys
APP_SECRET=your_32_character_random_secret_here
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Domain & CORS Configuration
FRONTEND_URL=https://reelsbundles.github.io
ALLOWED_ORIGINS=https://reelsbundles.github.io

# Cashfree PG Credentials (LIVE / SANDBOX)
CASHFREE_CLIENT_ID=your_cashfree_client_id
CASHFREE_CLIENT_SECRET=your_cashfree_client_secret
CASHFREE_ENV=PRODUCTION # or SANDBOX

# Admin Credentials
ADMIN_EMAIL=admin@example.com

# Support & Email (SMTP)
SUPPORT_EMAIL=support@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@example.com
SMTP_APP_PASSWORD=your_smtp_app_password
SMTP_FROM_NAME=ReelsBundles Support

# Feature Flags
TRUST_PROXY=true
DOWNLOAD_LOG_ENABLED=true
LIFETIME_ACCESS=true

# Firebase Service Account (Alternative to firebase-admin.json)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Google Drive Service Account for Secure Streaming
GOOGLE_SERVICE_ACCOUNT_EMAIL=your_service_account_email
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
